# Токен сообщества: Управление сообществом -> Работа с API -> Ключи доступа
VK_BOT_TOKEN=

# ID пользователя-оператора (VK user ID), для пересылки обращений
OPERATOR_PEER_ID=0

# ID администраторов VK через запятую
ADMIN_IDS=

# CRM выключена по умолчанию. Для настоящей интеграции включить и заполнить URL/ключ.
CRM_ENABLED=0
CRM_API_URL=
CRM_API_KEY=

# Координаты площадки в формате долгота,широта
VENUE_ENTRY=37.6160,55.7545
VENUE_WARDROBE=37.6165,55.7550
VENUE_HALL_A=37.6175,55.7555
VENUE_HALL_B=37.6185,55.7560
VENUE_PARKING=37.6155,55.7540
VENUE_EXIT=37.6160,55.7545

DATABASE_PATH=bot.db
